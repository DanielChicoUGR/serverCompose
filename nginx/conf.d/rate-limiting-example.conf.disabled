# ==============================================================================
# EJEMPLO: Configuración de Servidor con Rate Limiting
# ==============================================================================
# Este archivo muestra cómo aplicar rate limiting en tus configuraciones de
# servidor Nginx. Copia y adapta según tus necesidades.
#
# IMPORTANTE: Este es un archivo de EJEMPLO, no se incluye automáticamente.
# ==============================================================================

# Configuración de upstream (si es necesario)
upstream myapp {
    server myapp:8080;
}

# Server block con protección completa
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.ejemplo.com;

    # SSL certificates
    ssl_certificate /etc/letsencrypt/live/app.ejemplo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.ejemplo.com/privkey.pem;

    # ============================================================================
    # RATE LIMITING - General
    # ============================================================================
    # Aplica rate limiting general (10 req/s con burst de 20)
    location / {
        # Rate limiting - permite 10 req/s con ráfaga de 20
        limit_req zone=general burst=20 nodelay;
        
        # Limitar conexiones concurrentes (máximo 10 por IP)
        limit_conn addr 10;

        proxy_pass http://myapp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ============================================================================
    # RATE LIMITING - Login (más restrictivo)
    # ============================================================================
    # Protección especial para endpoints de autenticación
    location /web/login {
        # Rate limiting estricto - 5 req/min
        limit_req zone=login burst=3 nodelay;
        
        proxy_pass http://myapp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Otros endpoints de login
    location ~ ^/(login|signin|auth) {
        limit_req zone=login burst=3 nodelay;
        
        proxy_pass http://myapp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ============================================================================
    # RATE LIMITING - API (personalizado)
    # ============================================================================
    # Para APIs puedes permitir más requests
    location /api/ {
        # Rate limiting para API - 30 req/s
        limit_req zone=api burst=50 nodelay;
        
        proxy_pass http://myapp;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ============================================================================
    # SIN RATE LIMITING - Archivos Estáticos
    # ============================================================================
    # Los archivos estáticos generalmente no necesitan rate limiting
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
        # Sin rate limiting para assets
        proxy_pass http://myapp;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ============================================================================
    # PÁGINAS DE ERROR PERSONALIZADAS
    # ============================================================================
    # Página personalizada para error 429 (Too Many Requests)
    error_page 429 /429.html;
    location = /429.html {
        root /usr/share/nginx/html;
        internal;
    }
}

# ==============================================================================
# NOTAS IMPORTANTES
# ==============================================================================
#
# 1. Zonas definidas en nginx.conf:
#    - general: 10 req/s (uso general)
#    - login:   5 req/min (autenticación)
#    - api:     30 req/s (APIs)
#
# 2. Parámetros de limit_req:
#    - burst: Número de requests que pueden exceder el rate antes de rechazar
#    - nodelay: No retrasa las requests del burst, las procesa inmediatamente
#    - delay: Número de requests del burst que se procesan sin delay
#
# 3. limit_conn:
#    - Limita conexiones concurrentes por IP
#    - addr: zona definida en nginx.conf
#
# 4. Códigos de respuesta:
#    - 429: Too Many Requests (configurable con limit_req_status)
#    - 503: Service Unavailable (para limit_conn)
#
# 5. Monitoreo:
#    - Los mensajes de rate limiting aparecen en error.log
#    - Fail2Ban los detecta automáticamente
#
# ==============================================================================
# EJEMPLOS DE USO
# ==============================================================================
#
# Sitio web normal:
#   location / {
#       limit_req zone=general burst=20 nodelay;
#       proxy_pass http://backend;
#   }
#
# API REST:
#   location /api/ {
#       limit_req zone=api burst=50 nodelay;
#       proxy_pass http://api-backend;
#   }
#
# Formulario de login:
#   location /login {
#       limit_req zone=login burst=3 nodelay;
#       proxy_pass http://auth-backend;
#   }
#
# Sin rate limiting (admin desde red local):
#   location /admin {
#       allow 192.168.1.0/24;
#       deny all;
#       proxy_pass http://admin-backend;
#   }
#
# ==============================================================================
